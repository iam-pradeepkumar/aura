<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="aura_disaster_zone">
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <light name="sun" type="directional">
      <pose>0 0 30 0.3 0.5 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.42 0.38 0.32 1</ambient></material>
        </visual>
      </link>
    </model>
    <!-- Zone boundary markers (visual tape) -->
    <model name="zone_corner_1"><static>true</static><pose>2 2 0.05 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.2 0.2 0.1</size></box></geometry>
      <material><ambient>1 0.9 0.1 1</ambient></material></visual></link></model>
    <model name="zone_corner_2"><static>true</static><pose>38 2 0.05 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.2 0.2 0.1</size></box></geometry>
      <material><ambient>1 0.9 0.1 1</ambient></material></visual></link></model>
    <!-- Rubble obstacles (collision + visual cylinders) -->
    <model name="rubble_1"><static>true</static><pose>10 12 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>1.2</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>1.2</radius><length>1.0</length></cylinder></geometry>
      <material><ambient>0.5 0.45 0.4 1</ambient></material></visual></link></model>
    <model name="rubble_2"><static>true</static><pose>15 8 0.45 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.9</radius><length>0.9</length></cylinder></geometry></collision>
