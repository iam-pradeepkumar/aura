      <material><ambient>0.48 0.43 0.38 1</ambient></material></visual></link></model>
    <model name="rubble_3"><static>true</static><pose>22 14 0.75 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>1.5</radius><length>1.5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>1.5</radius><length>1.5</length></cylinder></geometry>
      <material><ambient>0.52 0.46 0.41 1</ambient></material></visual></link></model>
