    <!-- Spawn poses for robots (kinematic bridge uses these as initial state) -->
    <model name="aura_rover_spawn"><static>true</static><pose>4 4 0.2 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.6 0.5 0.3</size></box></geometry>
      <material><ambient>0.2 0.5 0.9 1</ambient></material></visual></link></model>
    <model name="aura_drone_spawn"><static>true</static><pose>4 4 6 0 0 0</pose>
